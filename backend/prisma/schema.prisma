generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  TAILOR
  ADMIN
}

enum Audience {
  MEN
  WOMEN
}

enum Category {
  SHALWAR_KAMEEZ
  KURTA
  WAISTCOAT
  KAMEEZ_SHALWAR
  SUIT
  TROUSER
  OTHER
}

enum GarmentType {
  MEN_SHALWAR_KAMEEZ
  MEN_KURTA
  MEN_TROUSER
  WOMEN_KAMEEZ
  WOMEN_BOTTOM
}

enum OptionType {
  COLLAR
  CUFF
  FRONT
  POCKET
  TROUSER_STYLE
  NECKLINE
  SLEEVE
  SHAPE
  BOTTOM_STYLE
  EXTRA
}

enum OrderStatus {
  PLACED
  ACCEPTED
  MEASUREMENTS_CONFIRMED
  STITCHING
  QUALITY_CHECK
  READY
  DELIVERED
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  COD
  PAY_AT_PICKUP
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  language     String   @default("en")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tailor       Tailor?
  measurements Measurement[]
  orders       Order[]      @relation("CustomerOrders")
  tryonRequests TryOnRequest[]
}

model Tailor {
  id              String   @id @default(cuid())
  userId          String   @unique
  shopName        String
  address         String
  city            String
  area            String
  whatsapp        String
  bio             String   @default("")
  rating          Float    @default(0)
  servesWomen     Boolean  @default(true)
  femaleStaff     Boolean  @default(false)
  portfolioImages String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  designs  Design[]
  fabrics  Fabric[]
  options  StyleOption[]
  orders   Order[]

  @@index([city])
}

model Design {
  id          String   @id @default(cuid())
  tailorId    String
  name        String
  audience    Audience
  category    Category
  basePrice   Decimal  @db.Decimal(10, 2)
  images      String[] @default([])
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tailor     Tailor       @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  fabrics    Fabric[]
  options    StyleOption[]
  orderItems OrderItem[]
  tryonRequests TryOnRequest[]

  @@index([tailorId, active])
  @@index([audience, active])
}

model Fabric {
  id            String  @id @default(cuid())
  designId      String
  tailorId      String
  name          String
  pricePerMeter Decimal @db.Decimal(10, 2)
  extraCharge   Decimal @default(0) @db.Decimal(10, 2)
  image         String?

  design Design     @relation(fields: [designId], references: [id], onDelete: Cascade)
  tailor Tailor     @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  items  OrderItem[]

  @@index([designId])
}

model StyleOption {
  id         String     @id @default(cuid())
  designId   String
  tailorId   String
  type       OptionType
  name       String
  extraPrice Decimal    @default(0) @db.Decimal(10, 2)

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  tailor Tailor @relation(fields: [tailorId], references: [id], onDelete: Cascade)

  @@index([designId])
}

model Measurement {
  id          String      @id @default(cuid())
  customerId  String
  label       String
  garmentType GarmentType
  values      Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer   User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([customerId, garmentType])
}

model Order {
  id               String       @id @default(cuid())
  orderNumber      String       @unique
  customerId       String
  tailorId         String
  status           OrderStatus  @default(PLACED)
  totalPrice       Decimal      @db.Decimal(10, 2)
  finalPrice       Decimal?     @db.Decimal(10, 2)
  offeredPrice     Decimal?     @db.Decimal(10, 2)
  deliveryType     DeliveryType
  dueDate          DateTime?
  notes            String?
  referencePhotoUrl String?
  cancelReason     String?
  quotedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  customer    User               @relation("CustomerOrders", fields: [customerId], references: [id])
  tailor      Tailor             @relation(fields: [tailorId], references: [id])
  items       OrderItem[]
  statusEvents OrderStatusEvent[]
  payment     Payment?
  review      Review?

  @@index([customerId, createdAt])
  @@index([tailorId, status])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  designId        String
  fabricId        String?
  measurementId   String?
  designName      String
  fabricName      String?
  quantity        Int
  price           Decimal  @db.Decimal(10, 2)
  selectedOptions Json     @default("[]")

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  design      Design       @relation(fields: [designId], references: [id])
  fabric      Fabric?      @relation(fields: [fabricId], references: [id])
  measurement Measurement? @relation(fields: [measurementId], references: [id])

  @@index([orderId])
}

model OrderStatusEvent {
  id          String      @id @default(cuid())
  orderId     String
  from        OrderStatus?
  to          OrderStatus
  note        String?
  actorUserId String?
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model TryOnRequest {
  id          String   @id @default(cuid())
  customerId  String
  designId    String
  inputImage  String?
  outputImage String?
  createdAt   DateTime @default(now())

  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
