{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/api-contract.md"],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "npm install": "allow",
      "npm run lint": "allow",
      "npm run typecheck": "allow",
      "npm test": "allow",
      "npm run test*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "docker compose ps": "allow",
      "docker compose up*": "allow",
      "docker compose down*": "allow",
      "rm *": "deny"
    }
  }
}
